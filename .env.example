# Supabase (Project Settings → API). Publishable key istemcide görünür; RLS ile korunur.
NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Uygulamanın açık adresi (e-posta doğrulama ve şifre sıfırlama dönüşleri için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
